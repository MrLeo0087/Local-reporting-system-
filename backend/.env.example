# Copy this file to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string
# Example (Neon/Supabase style): postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@host:port/database_name

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-string

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Folder where uploaded report photos are stored
UPLOAD_DIR=uploads

# Max upload size in megabytes
MAX_UPLOAD_MB=5

# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000

PORT=8000
